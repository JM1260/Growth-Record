---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts } from '../../data/posts';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const categories = ['全部', ...new Set(posts.map((post) => post.category))];
const categoryCounts = Object.fromEntries(
  categories.map((category) => [
    category,
    category === '全部' ? posts.length : posts.filter((post) => post.category === category).length,
  ]),
);
---

<BaseLayout title="文章｜向光生长" description={`收录 ${posts.length} 篇技术学习与成长随笔。`}>
  <section class="shell blog-hero">
    <div>
      <span class="eyebrow">Writing archive</span>
      <h1>文章。</h1>
      <p>技术、阅读与生活的长期记录。这里既有从 CSDN 同步的旧文章，也有在本站持续写下的新内容。</p>
    </div>
    <div class="archive-stat" aria-label={`共 ${posts.length} 篇文章`}>
      <strong>{String(posts.length).padStart(2, '0')}</strong>
      <span>篇公开文章</span>
      <a href="https://blog.csdn.net/weixin_42146176" target="_blank" rel="noreferrer">访问 CSDN ↗</a>
    </div>
  </section>

  <section class="shell blog-section">
    <div class="blog-toolbar">
      <label class="search-wrap">
        <span aria-hidden="true">⌕</span>
        <span class="sr-only">搜索文章</span>
        <input id="article-search" type="search" placeholder="搜索标题、摘要或标签…" autocomplete="off" />
      </label>
      <div class="filter-chips" aria-label="按分类筛选">
        {categories.map((category, index) => (
          <button
            class:list={['filter-chip', { active: index === 0 }]}
            type="button"
            data-category={category}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            {category}<span>{categoryCounts[category]}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="article-feed" id="article-feed">
      {posts.map((post, index) => (
        <article
          class="article-feed-item"
          data-category={post.category}
          data-search={`${post.title} ${post.excerpt} ${post.tags.join(' ')}`.toLowerCase()}
        >
          <span class="feed-index">{String(index + 1).padStart(2, '0')}</span>
          <a class="feed-main" href={`${base}posts/${post.slug}/`}>
            <div class="feed-meta">
              <span>{post.category}</span>
              <time datetime={post.date.replaceAll('.', '-')}>{post.date}</time>
              <span>{post.readTime}</span>
            </div>
            <h2>{post.title}</h2>
            <p>{post.excerpt}</p>
            {post.tags.length > 0 && (
              <div class="feed-tags" aria-label="文章标签">
                {post.tags.slice(0, 4).map((tag) => <span>#{tag}</span>)}
              </div>
            )}
          </a>
          <a class="feed-arrow" href={`${base}posts/${post.slug}/`} aria-label={`阅读《${post.title}》`}>↗</a>
        </article>
      ))}
    </div>
    <p class="empty-state" id="article-empty" hidden>没有找到匹配的文章，换个关键词试试。</p>
  </section>

  <script>
    const searchInput = document.querySelector<HTMLInputElement>('#article-search');
    const chips = [...document.querySelectorAll<HTMLButtonElement>('.filter-chip')];
    const items = [...document.querySelectorAll<HTMLElement>('.article-feed-item')];
    const emptyState = document.querySelector<HTMLElement>('#article-empty');
    let activeCategory = '全部';

    const filterArticles = () => {
      const query = searchInput?.value.trim().toLowerCase() ?? '';
      let visibleCount = 0;
      items.forEach((item) => {
        const matchesCategory = activeCategory === '全部' || item.dataset.category === activeCategory;
        const matchesQuery = !query || item.dataset.search?.includes(query);
        const visible = Boolean(matchesCategory && matchesQuery);
        item.hidden = !visible;
        if (visible) visibleCount += 1;
      });
      if (emptyState) emptyState.hidden = visibleCount !== 0;
    };

    searchInput?.addEventListener('input', filterArticles);
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        activeCategory = chip.dataset.category ?? '全部';
        chips.forEach((item) => {
          const active = item === chip;
          item.classList.toggle('active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        filterArticles();
      });
    });
  </script>
</BaseLayout>
