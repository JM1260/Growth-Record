---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { ADMIN_API_BASE } from '../../data/admin-config';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<AdminLayout>
  <main class="admin-app" data-api-base={ADMIN_API_BASE} data-site-base={base}>
    <section class="login-panel" id="login-panel">
      <div class="login-card">
        <a class="admin-brand" href={base}><span>↗</span> 向光生长</a>
        <span class="login-kicker">Private writing space</span>
        <h1>把新的想法，<br />写进成长里。</h1>
        <p>使用你的 GitHub 账号登录。文章会保存到 Growth-Record 仓库，并由 GitHub Pages 自动发布。</p>
        <button class="github-login" id="login-button" type="button">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.02c-3.22.7-3.9-1.36-3.9-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.57-.3-5.27-1.29-5.27-5.69 0-1.26.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.75 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.75.11 3.04.74.8 1.19 1.82 1.19 3.08 0 4.41-2.71 5.39-5.29 5.68.42.36.79 1.06.79 2.14v3.18c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
          使用 GitHub 安全登录
        </button>
        <small id="login-status">仅仓库所有者 JM1260 可以进入后台</small>
      </div>
      <div class="login-decoration" aria-hidden="true"><span>01</span><span>记录</span><span>发布</span></div>
    </section>

    <section class="workspace" id="workspace" hidden>
      <aside class="admin-sidebar">
        <div>
          <a class="admin-brand light" href={base}><span>↗</span> 向光生长</a>
          <button class="new-post" id="new-post-button" type="button"><span>＋</span> 写新文章</button>
          <nav class="admin-nav" aria-label="后台导航">
            <button class="active" type="button" data-filter="all"><span>文</span> 全部文章 <b id="all-count">0</b></button>
            <button type="button" data-filter="draft"><span>草</span> 草稿箱 <b id="draft-count">0</b></button>
            <button type="button" data-filter="published"><span>发</span> 已发布 <b id="published-count">0</b></button>
          </nav>
        </div>
        <div class="admin-account">
          <span class="account-avatar">JM</span>
          <div><strong id="account-name">JM1260</strong><small>仓库管理员</small></div>
          <button id="logout-button" type="button" title="退出登录">↪</button>
        </div>
      </aside>

      <div class="admin-main">
        <header class="admin-topbar">
          <div><span>写作后台</span><strong id="connection-label">正在连接…</strong></div>
          <div class="topbar-actions">
            <a href={`${base}posts/`} target="_blank">查看网站 ↗</a>
            <button class="mobile-menu" id="mobile-menu" type="button" aria-label="打开菜单">☰</button>
          </div>
        </header>

        <div class="admin-content">
          <section class="post-library" id="post-library">
            <header class="library-head">
              <div><span class="section-label">Content library</span><h1>文章</h1></div>
              <label class="admin-search"><span>⌕</span><input id="post-search" type="search" placeholder="搜索文章…" /></label>
            </header>
            <div class="post-table" id="post-table">
              <div class="empty-library" id="empty-library">
                <span>✦</span><h2>从第一篇文章开始</h2><p>点击“写新文章”，记录此刻的想法。</p>
              </div>
            </div>
          </section>

          <section class="editor" id="editor" hidden>
            <header class="editor-head">
              <button class="back-to-list" id="back-to-list" type="button">← 返回文章</button>
              <div class="editor-actions">
                <span class="save-state" id="save-state">尚未保存</span>
                <button class="ghost-button" id="save-draft" type="button">保存草稿</button>
                <button class="publish-button" id="publish-post" type="button">发布文章 <span>↗</span></button>
              </div>
            </header>

            <form class="editor-form" id="editor-form">
              <div class="editor-meta-row">
                <label><span>分类</span><input name="category" value="成长记录" placeholder="成长记录" /></label>
                <label><span>发布日期</span><input name="date" type="date" /></label>
                <label><span>阅读时间</span><input name="readTime" value="5 分钟" placeholder="5 分钟" /></label>
              </div>
              <textarea class="title-input" name="title" rows="2" placeholder="在这里输入文章标题…" required></textarea>
              <textarea class="excerpt-input" name="excerpt" rows="2" placeholder="写一段简短摘要，帮助读者快速了解这篇文章。"></textarea>
              <div class="slug-row">
                <span>文章地址 /posts/</span><input name="slug" placeholder="my-new-post" required /><span>/</span>
              </div>
              <label class="tags-field"><span>标签</span><input name="tags" placeholder="学习, Astro, 成长（用逗号分隔）" /></label>

              <div class="writing-toolbar" role="toolbar" aria-label="Markdown 格式工具">
                <button type="button" data-insert="**粗体**" title="粗体"><strong>B</strong></button>
                <button type="button" data-insert="_斜体_" title="斜体"><em>I</em></button>
                <button type="button" data-prefix="## " title="二级标题">H2</button>
                <button type="button" data-prefix="> " title="引用">❝</button>
                <button type="button" data-prefix="- " title="列表">≡</button>
                <button type="button" data-insert="[链接文字](https://)" title="链接">↗</button>
                <button type="button" data-insert="`代码`" title="行内代码">&lt;/&gt;</button>
                <span></span>
                <label class="image-upload" title="上传配图">⌁ 配图<input id="image-input" type="file" accept="image/png,image/jpeg,image/webp,image/gif" /></label>
                <div class="view-switch" aria-label="编辑模式">
                  <button class="active" type="button" data-view="write">编辑</button><button type="button" data-view="preview">预览</button>
                </div>
              </div>

              <textarea class="markdown-input" name="content" id="markdown-input" placeholder="用 Markdown 开始写作…\n\n## 一个小标题\n\n正文内容写在这里。"></textarea>
              <article class="markdown-preview article-rich" id="markdown-preview" hidden></article>
            </form>
          </section>
        </div>
      </div>
    </section>

    <div class="toast" id="toast" role="status" hidden></div>
  </main>

  <script>
    const app = document.querySelector<HTMLElement>('.admin-app');
    const apiBase = app?.dataset.apiBase?.replace(/\/$/, '') ?? '';
    const siteBase = app?.dataset.siteBase ?? '/';
    const loginPanel = document.querySelector<HTMLElement>('#login-panel');
    const workspace = document.querySelector<HTMLElement>('#workspace');
    const loginStatus = document.querySelector<HTMLElement>('#login-status');
    const library = document.querySelector<HTMLElement>('#post-library');
    const editor = document.querySelector<HTMLElement>('#editor');
    const form = document.querySelector<HTMLFormElement>('#editor-form');
    const markdownInput = document.querySelector<HTMLTextAreaElement>('#markdown-input');
    const preview = document.querySelector<HTMLElement>('#markdown-preview');
    const toast = document.querySelector<HTMLElement>('#toast');
    const saveState = document.querySelector<HTMLElement>('#save-state');
    const table = document.querySelector<HTMLElement>('#post-table');
    const search = document.querySelector<HTMLInputElement>('#post-search');
    let posts: Array<Record<string, any>> = [];
    let activeFilter = 'all';
    let editingOriginalSlug = '';

    const tokenKey = 'growth-record-admin-session';
    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[char] ?? char);
    const showToast = (message: string, error = false) => {
      if (!toast) return;
      toast.textContent = message;
      toast.classList.toggle('error', error);
      toast.hidden = false;
      window.setTimeout(() => { toast.hidden = true; }, 3600);
    };
    const api = async (path: string, options: RequestInit = {}) => {
      const token = sessionStorage.getItem(tokenKey);
      const response = await fetch(`${apiBase}${path}`, {
        ...options,
        headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}), ...options.headers },
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || '请求失败，请稍后重试');
      return data;
    };

    const renderMarkdown = (source: string) => {
      const safe = escapeHtml(source).replace(/\r\n/g, '\n');
      const blocks = safe.split(/\n{2,}/).map((block) => {
        if (block.startsWith('```') && block.endsWith('```')) return `<pre><code>${block.replace(/^```[^\n]*\n?/, '').replace(/```$/, '')}</code></pre>`;
        if (/^### /.test(block)) return `<h3>${block.slice(4)}</h3>`;
        if (/^## /.test(block)) return `<h2>${block.slice(3)}</h2>`;
        if (/^# /.test(block)) return `<h2>${block.slice(2)}</h2>`;
        if (block.split('\n').every((line) => /^- /.test(line))) return `<ul>${block.split('\n').map((line) => `<li>${line.slice(2)}</li>`).join('')}</ul>`;
        if (block.startsWith('&gt; ')) return `<blockquote><p>${block.replace(/^&gt; /gm, '')}</p></blockquote>`;
        return `<p>${block.replace(/\n/g, '<br>')}</p>`;
      }).join('');
      return blocks
        .replace(/!\[([^\]]*)\]\((https?:\/\/[^)]+|\/[^)]+)\)/g, '<img src="$2" alt="$1">')
        .replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g, '<a href="$2" target="_blank" rel="noreferrer">$1</a>')
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
        .replace(/`([^`]+)`/g, '<code>$1</code>');
    };
    const updatePreview = () => { if (preview && markdownInput) preview.innerHTML = renderMarkdown(markdownInput.value); };

    const today = () => new Date().toISOString().slice(0, 10);
    const suggestSlug = (title: string) => {
      const ascii = title.toLowerCase().trim().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
      return ascii || `post-${Date.now().toString(36)}`;
    };
    const openEditor = (post?: Record<string, any>) => {
      library?.setAttribute('hidden', '');
      editor?.removeAttribute('hidden');
      editingOriginalSlug = post?.slug ?? '';
      if (!form) return;
      const fields = form.elements as any;
      fields.title.value = post?.title ?? '';
      fields.slug.value = post?.slug ?? '';
      fields.excerpt.value = post?.excerpt ?? '';
      fields.category.value = post?.category ?? '成长记录';
      fields.tags.value = (post?.tags ?? []).join(', ');
      fields.date.value = (post?.date ?? today()).replaceAll('.', '-');
      fields.readTime.value = post?.readTime ?? '5 分钟';
      fields.content.value = post?.content ?? '';
      if (saveState) saveState.textContent = post ? (post.draft ? '草稿' : '已发布') : '尚未保存';
      updatePreview();
      fields.title.focus();
    };
    const closeEditor = () => {
      editor?.setAttribute('hidden', '');
      library?.removeAttribute('hidden');
    };
    const updateCounts = () => {
      const authored = posts.filter((post) => post.source !== 'csdn');
      const set = (id: string, count: number) => { const el = document.querySelector(id); if (el) el.textContent = String(count); };
      set('#all-count', authored.length); set('#draft-count', authored.filter((p) => p.draft).length); set('#published-count', authored.filter((p) => !p.draft).length);
    };
    const renderPosts = () => {
      if (!table) return;
      const query = search?.value.trim().toLowerCase() ?? '';
      const filtered = posts.filter((post) => {
        const matchesFilter = activeFilter === 'all' || (activeFilter === 'draft' ? post.draft : !post.draft);
        return matchesFilter && (!query || `${post.title} ${post.excerpt ?? ''}`.toLowerCase().includes(query));
      });
      if (!filtered.length) {
        table.innerHTML = '<div class="empty-library"><span>✦</span><h2>这里还没有文章</h2><p>点击“写新文章”，记录此刻的想法。</p></div>';
        return;
      }
      table.innerHTML = filtered.map((post) => `<button class="post-table-row" type="button" data-slug="${escapeHtml(post.slug)}"><span class="status-dot ${post.draft ? 'draft' : ''}"></span><span><strong>${escapeHtml(post.title)}</strong><small>${escapeHtml(post.excerpt || '暂无摘要')}</small></span><time>${escapeHtml(post.date || '')}</time><b>${post.draft ? '草稿' : '已发布'}</b><i>→</i></button>`).join('');
      table.querySelectorAll<HTMLButtonElement>('[data-slug]').forEach((button) => button.addEventListener('click', async () => {
        try {
          const result = await api(`/api/posts/${encodeURIComponent(button.dataset.slug ?? '')}`);
          openEditor(result.post);
        } catch (error) { showToast(error instanceof Error ? error.message : '文章读取失败', true); }
      }));
    };
    const loadPosts = async () => {
      const result = await api('/api/posts');
      posts = result.posts ?? [];
      updateCounts(); renderPosts();
      const label = document.querySelector('#connection-label');
      if (label) label.textContent = '已连接 GitHub';
      const name = document.querySelector('#account-name');
      if (name && result.user?.login) name.textContent = result.user.login;
    };
    const collectPost = (draft: boolean) => {
      if (!form) return null;
      const data = new FormData(form);
      const title = String(data.get('title') ?? '').trim();
      let slug = String(data.get('slug') ?? '').trim();
      if (!slug) slug = suggestSlug(title);
      return { originalSlug: editingOriginalSlug, title, slug, excerpt: String(data.get('excerpt') ?? '').trim(), category: String(data.get('category') ?? '').trim(), tags: String(data.get('tags') ?? '').split(/[,，]/).map((item) => item.trim()).filter(Boolean), date: String(data.get('date') ?? today()).replaceAll('-', '.'), readTime: String(data.get('readTime') ?? '').trim(), content: String(data.get('content') ?? ''), draft };
    };
    const savePost = async (draft: boolean) => {
      const post = collectPost(draft);
      if (!post?.title || !post.slug || !post.content) { showToast('请填写标题、文章地址和正文', true); return; }
      const button = document.querySelector<HTMLButtonElement>(draft ? '#save-draft' : '#publish-post');
      if (button) button.disabled = true;
      if (saveState) saveState.textContent = '正在提交…';
      try {
        const result = await api('/api/posts/save', { method: 'POST', body: JSON.stringify(post) });
        editingOriginalSlug = post.slug;
        if (saveState) saveState.textContent = draft ? '草稿已保存' : '已发布，网站正在更新';
        showToast(draft ? '草稿已安全保存到 GitHub' : '发布成功，网站将在约 1 分钟后更新');
        await loadPosts();
        if (!draft && result.url) window.open(result.url, '_blank', 'noopener');
      } catch (error) { if (saveState) saveState.textContent = '保存失败'; showToast(error instanceof Error ? error.message : '保存失败', true); }
      finally { if (button) button.disabled = false; }
    };

    document.querySelector('#login-button')?.addEventListener('click', () => {
      const returnTo = `${location.origin}${siteBase}admin/`;
      location.href = `${apiBase}/api/auth/start?return_to=${encodeURIComponent(returnTo)}`;
    });
    document.querySelector('#logout-button')?.addEventListener('click', () => { sessionStorage.removeItem(tokenKey); location.reload(); });
    document.querySelector('#mobile-menu')?.addEventListener('click', () => document.querySelector('.admin-sidebar')?.classList.toggle('open'));
    document.querySelector('#new-post-button')?.addEventListener('click', () => openEditor());
    document.querySelector('#back-to-list')?.addEventListener('click', closeEditor);
    document.querySelector('#save-draft')?.addEventListener('click', () => savePost(true));
    document.querySelector('#publish-post')?.addEventListener('click', () => savePost(false));
    search?.addEventListener('input', renderPosts);
    document.querySelectorAll<HTMLButtonElement>('.admin-nav button').forEach((button) => button.addEventListener('click', () => {
      activeFilter = button.dataset.filter ?? 'all';
      document.querySelectorAll('.admin-nav button').forEach((item) => item.classList.toggle('active', item === button));
      document.querySelector('.admin-sidebar')?.classList.remove('open');
      renderPosts();
    }));
    document.querySelectorAll<HTMLButtonElement>('.writing-toolbar button[data-insert], .writing-toolbar button[data-prefix]').forEach((button) => button.addEventListener('click', () => {
      if (!markdownInput) return;
      const start = markdownInput.selectionStart; const end = markdownInput.selectionEnd;
      const selected = markdownInput.value.slice(start, end);
      const value = button.dataset.prefix ? `${button.dataset.prefix}${selected}` : (button.dataset.insert ?? '').replace(/粗体|斜体|链接文字|代码/, selected || '$&');
      markdownInput.setRangeText(value, start, end, 'end'); markdownInput.focus(); updatePreview();
    }));
    document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((button) => button.addEventListener('click', () => {
      const isPreview = button.dataset.view === 'preview';
      document.querySelectorAll('[data-view]').forEach((item) => item.classList.toggle('active', item === button));
      markdownInput?.toggleAttribute('hidden', isPreview); preview?.toggleAttribute('hidden', !isPreview); if (isPreview) updatePreview();
    }));
    document.querySelector<HTMLInputElement>('#image-input')?.addEventListener('change', async (event) => {
      const input = event.currentTarget as HTMLInputElement; const file = input.files?.[0]; const slug = String(new FormData(form ?? undefined).get('slug') ?? '').trim();
      if (!file) return; if (!slug) { showToast('请先填写文章地址，再上传配图', true); input.value = ''; return; }
      try {
        const dataUrl = await new Promise<string>((resolve, reject) => { const reader = new FileReader(); reader.onload = () => resolve(String(reader.result)); reader.onerror = reject; reader.readAsDataURL(file); });
        const result = await api('/api/uploads', { method: 'POST', body: JSON.stringify({ slug, name: file.name, data: dataUrl }) });
        const markdown = `![${file.name}](${result.url})`;
        if (markdownInput) markdownInput.setRangeText(`\n\n${markdown}\n\n`, markdownInput.selectionStart, markdownInput.selectionEnd, 'end');
        updatePreview(); showToast('配图已上传并插入正文');
      } catch (error) { showToast(error instanceof Error ? error.message : '图片上传失败', true); }
      finally { input.value = ''; }
    });
    form?.addEventListener('input', (event) => {
      if (saveState) saveState.textContent = '有未保存的修改';
      const target = event.target as HTMLInputElement;
      if (target.name === 'title') { const slug = form.elements.namedItem('slug') as HTMLInputElement; if (slug && !slug.value && target.value) slug.value = suggestSlug(target.value); }
      if (target.name === 'content') updatePreview();
    });

    const hash = new URLSearchParams(location.hash.slice(1));
    const returnedToken = hash.get('session');
    const authError = hash.get('error');
    if (returnedToken) { sessionStorage.setItem(tokenKey, returnedToken); history.replaceState(null, '', location.pathname); }
    if (authError && loginStatus) { loginStatus.textContent = decodeURIComponent(authError); loginStatus.classList.add('error'); history.replaceState(null, '', location.pathname); }
    if (sessionStorage.getItem(tokenKey)) {
      loginPanel?.setAttribute('hidden', ''); workspace?.removeAttribute('hidden');
      loadPosts().catch((error) => { sessionStorage.removeItem(tokenKey); workspace?.setAttribute('hidden', ''); loginPanel?.removeAttribute('hidden'); if (loginStatus) { loginStatus.textContent = error instanceof Error ? error.message : '登录已过期，请重新登录'; loginStatus.classList.add('error'); } });
    }
  </script>
</AdminLayout>
